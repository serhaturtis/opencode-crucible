{
  "name": "@serhaturtis/opencode-crucible",
  "version": "0.2.0",
  "description": "Adversarial design loop for opencode (v2): an Architect generates a design, a Falsifier attacks it with evidence-backed findings, and the plugin is the Referee. Ships a TUI status panel.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/server.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./src/tui.ts"
    }
  },
  "files": [
    "dist",
    "server.ts",
    "tui.ts",
    "src/tui.ts"
  ],
  "scripts": {
    "build": "bun build ./src/server.ts --outdir ./dist --target bun --external @opencode/plugin --external zod --entry-naming server.js",
    "test": "bun test",
    "pack": "bun pm pack",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.26"
  }
}
